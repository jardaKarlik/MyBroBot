# Server
PORT=3000

# ClickUp Configuration
CLICKUP_API_TOKEN=pk_your_clickup_token_here
CLICKUP_WEBHOOK_SECRET=your_webhook_secret_here

# OpenClaw Configuration
OPENCLAW_URL=https://leecz.up.railway.app
OPENCLAW_API_TOKEN=your_openclaw_token_here
OPENCLAW_AGENT_ID=openclaw/default

# Status Mappings (must match your ClickUp list statuses, lowercase)
STATUS_TRIGGER=for agent
STATUS_IN_PROGRESS=in progress
STATUS_REVIEW=review
STATUS_FAILED=failed

# Optional: Auto-register webhook on startup
# AUTO_REGISTER_WEBHOOK=true
# WEBHOOK_CALLBACK_URL=https://your-bridge-url.railway.app/webhook/clickup
# CLICKUP_WORKSPACE_ID=your_workspace_id
# CLICKUP_LIST_ID=your_list_id
